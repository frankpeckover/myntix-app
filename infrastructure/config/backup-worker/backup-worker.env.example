# One PostgreSQL worker account for the catalogue, platform, and tenants.
BACKUP_POSTGRES_HOST=localhost
BACKUP_POSTGRES_PORT=5432
BACKUP_POSTGRES_USER=myntix_backup
BACKUP_POSTGRES_PASSWORD=change_me

# Database names on that PostgreSQL server.
BACKUP_CATALOG_DATABASE=myntix_backup
BACKUP_PLATFORM_DATABASE=app_platform
BACKUP_SHARED_DATABASE=myntix_app
BACKUP_APP_USER=myntix_web

# Private rclone crypt remote backed by R2.
RCLONE_CONFIG=/etc/myntix/rclone.conf
BACKUP_RCLONE_REMOTE=encrypted-r2:myntix-backup

# Optional. These defaults are suitable for a small deployment.
BACKUP_LOCAL_DIR=/var/lib/myntix-backup-worker
BACKUP_RETENTION_DAYS=7
