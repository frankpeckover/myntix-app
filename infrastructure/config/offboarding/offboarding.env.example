# PostgreSQL administrator used only by the manually invoked offboarding CLI.
# It must be able to update the platform catalogue and drop tenant schemas/databases.
OFFBOARD_POSTGRES_HOST=192.168.1.136
OFFBOARD_POSTGRES_PORT=5432
OFFBOARD_POSTGRES_USER=postgres
OFFBOARD_POSTGRES_PASSWORD=change_me

# Shared database used by schema tenants.
OFFBOARD_SHARED_DATABASE=myntix_app

# Backup catalogue and encrypted R2 remote.
OFFBOARD_BACKUP_DATABASE=myntix_backup
OFFBOARD_RCLONE_REMOTE=cloudflareR2:myntix-backup
RCLONE_CONFIG=/etc/myntix/rclone.conf

# Application checkout containing public/uploads.
OFFBOARD_APP_DIRECTORY=/opt/myntix/app
