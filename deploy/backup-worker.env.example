# Dedicated backup catalogue worker login
BACKUP_WORKER_CATALOG_HOST=192.168.1.136
BACKUP_WORKER_CATALOG_PORT=5432
BACKUP_WORKER_CATALOG_DATABASE=myntix_backup
BACKUP_WORKER_CATALOG_USER=backup_worker_user
BACKUP_WORKER_CATALOG_PASSWORD=change_me

# Dedicated platform worker login with SELECT on organisations and permission
# to update maintenance_mode, maintenance_message, and updated_at.
BACKUP_WORKER_PLATFORM_HOST=192.168.1.136
BACKUP_WORKER_PLATFORM_PORT=5432
BACKUP_WORKER_PLATFORM_DATABASE=app_platform
BACKUP_WORKER_PLATFORM_USER=backup_platform_worker
BACKUP_WORKER_PLATFORM_PASSWORD=change_me

# PostgreSQL backup/restore role available on tenant database hosts.
BACKUP_PG_USER=postgres_backup_user
BACKUP_PG_PASSWORD=change_me

# Shared database details used by schema-mode tenants.
BACKUP_SHARED_HOST=192.168.1.136
BACKUP_SHARED_PORT=5432
BACKUP_SHARED_DATABASE=myntix_app
BACKUP_SHARED_APP_USER=shared_app_user

# Private rclone crypt remote backed by R2.
RCLONE_CONFIG=/etc/myntix/rclone.conf
BACKUP_RCLONE_REMOTE=encrypted-r2:myntix-backup
BACKUP_LOCAL_DIR=/var/lib/myntix-backup-worker

# Worker behaviour.
BACKUP_WORKER_POLL_SECONDS=10
BACKUP_WORKER_LEASE_MINUTES=120
BACKUP_RETENTION_DAYS=7
