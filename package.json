{
  "name": "internal-currency-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:env": "node scripts/check-production-env.mjs",
    "dev": "next dev",
    "prebuild": "npm run check:env",
    "build": "next build",
    "create-api-client": "node scripts/create-api-client-key.mjs",
    "maintenance": "node scripts/manage-platform-announcement.mjs",
    "sync:tass": "node scripts/run-directory-sync-job.mjs",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "test:api": "node --test --test-concurrency=1 tests/api/authentication.test.mjs tests/api/accounts.test.mjs tests/api/ledger.test.mjs tests/api/holds.test.mjs tests/api/rewards-purchases.test.mjs tests/api/scopes.test.mjs tests/api/rate-limits.test.mjs",
    "test:a11y": "playwright test --project=desktop-chromium",
    "test:browsers": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "next": "16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
