# Platform database (required)
PLATFORM_POSTGRES_HOST=localhost
PLATFORM_POSTGRES_DATABASE=app_platform
PLATFORM_POSTGRES_USER=myntix_web
PLATFORM_POSTGRES_PASSWORD=change_me
# Optional when PostgreSQL uses its standard port.
PLATFORM_POSTGRES_PORT=5432

# Backup catalogue database (optional until self-service backups are enabled)
BACKUP_CATALOG_HOST=localhost
BACKUP_CATALOG_DATABASE=myntix_backup
BACKUP_CATALOG_USER=myntix_web
BACKUP_CATALOG_PASSWORD=change_me
BACKUP_CATALOG_PORT=5432

# Shared tenant database (required when any tenant uses schema mode)
APP_POSTGRES_HOST=localhost
APP_POSTGRES_DATABASE=myntix_app
APP_POSTGRES_USER=myntix_web
APP_POSTGRES_PASSWORD=change_me
# Optional when PostgreSQL uses its standard port.
APP_POSTGRES_PORT=5432

# Tenant routing and canonical URL (required)
LOCAL_ORGANISATION_SLUG=local
APP_ROOT_DOMAIN=app.local
APP_BASE_URL=http://localhost:3000

# Independent server secrets (required in production; do not reuse values)
SESSION_TOKEN_HASH_SECRET=change_this_to_a_long_random_secret
SSO_SECRET_ENCRYPTION_KEY=change_this_to_a_different_long_random_secret
API_KEY_HASH_SECRET=change_this_to_another_long_random_secret

# Email and scheduled internal jobs (optional)
EMAIL_FROM=
RESEND_API_KEY=
ORGANISATION_DELETION_REQUEST_EMAIL=support@myntix.com
INTERNAL_JOB_SECRET=

# Public branding overrides (optional; code defaults are production-ready)
NEXT_PUBLIC_APP_NAME=Myntix Ledger
NEXT_PUBLIC_APP_LOGO_URL=/brand/myntix-stacked-coins.png
NEXT_PUBLIC_APP_LOCKUP_URL=/brand/myntix-lockup.png
NEXT_PUBLIC_APP_WORDMARK_URL=/brand/myntix-wordmark.png
NEXT_PUBLIC_APP_TAGLINE=Internal currency, made simple.
NEXT_PUBLIC_APP_DESCRIPTION=An internal currency ledger for organisations.
NEXT_PUBLIC_APP_SUPPORT_EMAIL=support@myntix.com
NEXT_PUBLIC_APP_VERSION=1.0
NEXT_PUBLIC_MARKETING_SITE_URL=https://myntix.com
# Optional; derived from the app name when omitted.
NEXT_PUBLIC_APP_INITIALS=ML
# Optional fallback used before a tenant's organisation settings load.
NEXT_PUBLIC_DEFAULT_ORGANISATION_NAME=Demo School

# Runtime overrides (optional)
APP_HOST=0.0.0.0
APP_PORT=3000
ALLOW_ORGANISATION_HEADER_OVERRIDE=false
DISABLE_HTTPS_REDIRECT=false
API_GLOBAL_RATE_LIMIT_PER_MINUTE=600
API_READ_RATE_LIMIT_PER_MINUTE=300
API_WRITE_RATE_LIMIT_PER_MINUTE=60
